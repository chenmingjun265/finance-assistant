# MCP 服务地址；四个 MCP 与主程序在同一台电脑运行时使用 127.0.0.1
server_url=127.0.0.1

# DeepSeek：负责多智能体推理与路由
DEEPSEEK_API_KEY=your_deepseek_api_key

# 阿里云百炼 DashScope：负责 Qwen 对话与向量化
API_KEY=your_dashscope_api_key

# 可选：百炼应用检索，仅 finance_news_search_consult_tool 使用
APP_ID=your_dashscope_app_id
APP_API_KEY=your_dashscope_app_api_key
